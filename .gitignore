# ClaimLens .gitignore
# ====================

# ==============================
# Environment & Secrets
# ==============================
.env
.env.local
.env.prod
.env.production
.env.development
.env.staging
*.env
!.env.sample
!.env.example
.env.nainika
env.sample

# AWS credentials
.aws/
aws-credentials
credentials.json

# ==============================
# Python
# ==============================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
dump.rdb

# Virtual environments
venv/
ENV/
env/
.venv/
.conda/

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# ==============================
# Node.js / Frontend
# ==============================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# Build outputs
frontend/build/
frontend/dist/
*.bundle.js
*.bundle.js.map

# ==============================
# IDE & Editors
# ==============================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# JetBrains
*.iml
.idea/

# ==============================
# OS Generated
# ==============================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ==============================
# Docker
# ==============================
# Don't ignore docker files, but ignore volumes data
docker-volumes/

# ==============================
# Logs
# ==============================
logs/
*.log
backend/logs/
frontend/logs/

# ==============================
# Database
# ==============================
*.db
*.sqlite
*.sqlite3

# ==============================
# Backups
# ==============================
backups/
*.sql
*.dump
*.bak
!backend/scripts/init-db.sql

# ==============================
# Models & Data (Large files)
# ==============================
models/
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.gguf
*.ggml

# FAISS indexes
faiss_*/
*.faiss

# HuggingFace cache
.cache/

# ==============================
# Uploads & Generated
# ==============================
uploads/
temp/
tmp/
*.tmp

# ==============================
# Certificates
# ==============================
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx

# ==============================
# Terraform / CloudFormation
# ==============================
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
*.auto.tfvars

# ==============================
# Misc
# ==============================
*.pid
*.seed
*.pid.lock
.grunt
.lock-wscript
storage/