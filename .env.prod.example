# ClaimLens Production Environment Template
# Copy this to .env.prod and replace placeholder values.
# IMPORTANT: Never commit .env.prod to git.

# ==============================
# Core App
# ==============================
APP_NAME=ClaimLens AI
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api/v1
ALLOWED_HOSTS=*
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ==============================
# Security
# ==============================
# Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================
# Database (RDS or containerized Postgres)
# ==============================
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
DB_NAME=claimlens
DATABASE_URL=postgresql+asyncpg://postgres:REPLACE_WITH_DB_PASSWORD@db:5432/claimlens
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ==============================
# Redis (ElastiCache or containerized Redis)
# ==============================
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/0

# ==============================
# AWS / S3
# ==============================
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_ACCESS_KEY
AWS_ENDPOINT_URL=
S3_ENDPOINT_URL=
USE_LOCALSTACK=false
S3_BUCKET_NAME=claimlens-prod-documents-ap-south-1
S3_PRESIGNED_URL_EXPIRY=3600

# ==============================
# LLM / Embeddings
# Profile A (recommended): AWS Bedrock
# ==============================
USE_MOCK_LLM=false
BEDROCK_ENABLED=true
EMBEDDING_MODE=bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v1

# ==============================
# LLM / Embeddings
# Profile B (open-source/local fallback)
# NOTE: This app currently uses MockLLM when Bedrock is disabled.
# Keep these commented unless you explicitly want local/mock behavior.
# ==============================
# USE_MOCK_LLM=true
# BEDROCK_ENABLED=false
# EMBEDDING_MODE=local
# EMBEDDING_MODEL_SIZE=base
# LOCAL_MODEL_PATH=/app/models

# FAISS index paths
FAISS_INDEX_PATH=/app/faiss_claimlens_index
FAISS_COMBINED_INDEX_PATH=/app/faiss_claimlens_combined_index

# ==============================
# Upload / Rate-limit / Logging
# ==============================
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=.pdf,.json
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
LOG_LEVEL=INFO
LOG_FORMAT=json

# Frontend build/runtime (if needed in your deploy process)
VITE_API_URL=/api/v1
