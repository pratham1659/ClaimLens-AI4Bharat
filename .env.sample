# ClaimLens Environment Configuration
# =====================================
# Single configuration file for both LOCAL and PRODUCTION environments
# Copy this to .env and set ENVIRONMENT=local or ENVIRONMENT=production
#
# Usage:
#   Local:  ENVIRONMENT=local ./docker-manage.sh start
#   Prod:   ENVIRONMENT=production ./docker-manage.sh start

# ==============================
# ENVIRONMENT SWITCH
# ==============================
# Set to 'local' for development or 'production' for AWS deployment
ENVIRONMENT=local

# ==============================
# Core App Configuration
# ==============================
APP_NAME="ClaimLens AI"
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
ALLOWED_HOSTS=*

# Local: Allow all origins for development
# Production: Set specific domains
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ==============================
# Security
# ==============================
# Generate with: openssl rand -hex 32
# Local: Use default for development
# Production: MUST replace with secure random key
SECRET_KEY=dev-secret-key-change-in-production-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================
# API Documentation Security
# ==============================
# Control access to Swagger/OpenAPI docs
# Local: Enabled for development
# Production: Disable or protect with authentication

# Disable Swagger in production (set to false)
DOCS_ENABLED=true

# Basic auth for Swagger (optional, use in staging)
# Set both to enable basic auth protection
DOCS_USERNAME=
DOCS_PASSWORD=

# Restrict docs to specific IPs (comma-separated)
# Leave empty to allow all (local) or set specific IPs (production)
DOCS_ALLOWED_IPS=

# ==============================
# Database Configuration
# ==============================
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=claimlens
DB_HOST=db
DB_PORT=5432

# Connection URL (auto-constructed, override if needed)
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ==============================
# Redis Configuration
# ==============================
REDIS_HOST=redis
REDIS_PORT=6379
# Local: No password needed
# Production: Set secure password
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# Host port mapping (change if 6379 is in use)
REDIS_HOST_PORT=6379

# ==============================
# AWS Configuration
# ==============================
AWS_REGION=ap-south-1

# Local: Use test credentials (LocalStack doesn't validate)
# Production: Set real AWS credentials
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# S3 Configuration
S3_BUCKET_NAME=claimlens-documents
S3_PRESIGNED_URL_EXPIRY=3600

# Local: Use LocalStack endpoint
# Production: Leave empty to use real AWS
USE_LOCALSTACK=true
S3_ENDPOINT_URL=http://localstack:4566
AWS_ENDPOINT_URL=http://localstack:4566

# ==============================
# LLM / AI Configuration
# ==============================
# Available Modes:
#
# 1. MOCK MODE (default for UI testing):
#    USE_MOCK_LLM=true, BEDROCK_ENABLED=false, OLLAMA_ENABLED=false
#    - Returns simulated responses
#    - No model loading, fastest startup
#
# 2. OLLAMA MODE (local AI with real responses):
#    USE_MOCK_LLM=false, BEDROCK_ENABLED=false, OLLAMA_ENABLED=true
#    - Uses local Ollama server
#    - Free, runs on your machine
#    - See docs/LLM_MODELS_GUIDE.md for model options
#
# 3. BEDROCK MODE (production with AWS):
#    USE_MOCK_LLM=false, BEDROCK_ENABLED=true, OLLAMA_ENABLED=false
#    - Uses AWS Bedrock Claude models
#    - Pay per token, best quality

USE_MOCK_LLM=true
BEDROCK_ENABLED=false
OLLAMA_ENABLED=false
EMBEDDING_MODE=mock
SKIP_MODEL_LOADING=true

# ==============================
# Ollama Configuration (Local LLM)
# ==============================
# Start Ollama: docker compose --profile ollama up -d
# Pull model: docker exec claimlens-ollama ollama pull llama3.2:3b
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Recommended Ollama models by RAM:
#   8GB RAM:  llama3.2:1b, phi3:mini
#   16GB RAM: llama3.2:3b (recommended), mistral:7b
#   32GB RAM: llama3.1:8b, codellama:13b

# ==============================
# AWS Bedrock Configuration (Production)
# ==============================
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v1

# Available Bedrock models:
#   anthropic.claude-3-haiku-20240307-v1:0 (fast, cheap)
#   anthropic.claude-3-sonnet-20240229-v1:0 (balanced)
#   anthropic.claude-3-5-sonnet-20241022-v2:0 (best)
#   anthropic.claude-3-opus-20240229-v1:0 (most capable)

# ==============================
# Local Embedding Models
# ==============================
# Used when EMBEDDING_MODE=local
EMBEDDING_MODEL_SIZE=base
LOCAL_MODEL_PATH=/app/models

# Available sizes: small, base, large
# small: bge-small-en-v1.5 (384 dim, 500MB)
# base:  bge-base-en-v1.5 (768 dim, 1GB) - recommended
# large: bge-large-en-v1.5 (1024 dim, 2GB)

# ==============================
# Vector Store / FAISS
# ==============================
FAISS_INDEX_PATH=/app/faiss_claimlens_index
FAISS_COMBINED_INDEX_PATH=/app/faiss_claimlens_combined_index

# ==============================
# Upload & Rate Limiting
# ==============================
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=.pdf,.json
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ==============================
# Logging
# ==============================
# Local: DEBUG level with plain text
# Production: INFO level with JSON format
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=plain

# ==============================
# Frontend Configuration
# ==============================
# Local: React dev server on port 3000
# Production: Built static files served via nginx
REACT_APP_API_URL=http://localhost:8000/api/v1
VITE_API_URL=/api/v1

# ==============================
# PRODUCTION OVERRIDES
# ==============================
# When ENVIRONMENT=production, set these values:
#
# ENVIRONMENT=production
# DEBUG=false
# LOG_LEVEL=INFO
# LOG_FORMAT=json
#
# # Security
# SECRET_KEY=<generate-with-openssl-rand-hex-32>
# CORS_ORIGINS=https://your-domain.com
#
# # Database (AWS RDS or similar)
# DB_PASSWORD=<secure-password>
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@<rds-endpoint>:5432/claimlens
#
# # Redis (AWS ElastiCache or similar)
# REDIS_PASSWORD=<secure-password>
# REDIS_URL=redis://:<password>@<elasticache-endpoint>:6379/0
#
# # AWS (Real credentials)
# AWS_ACCESS_KEY_ID=<your-access-key>
# AWS_SECRET_ACCESS_KEY=<your-secret-key>
# USE_LOCALSTACK=false
# S3_ENDPOINT_URL=
# AWS_ENDPOINT_URL=
#
# # LLM (AWS Bedrock)
# USE_MOCK_LLM=false
# BEDROCK_ENABLED=true
# EMBEDDING_MODE=bedrock
# SKIP_MODEL_LOADING=false
